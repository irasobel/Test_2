// Prisma schema — מבחן אמריקאי מקוון בעברית
// PostgreSQL + Prisma 6

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// מרצה / מנהל מערכת — מתחבר עם אימייל וסיסמה
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_users")
}

/// מבחן — כולל מועד, משך וסוג הרשאת הגשה
model Exam {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  courseName   String
  cycle        Int
  term         String
  examDate     DateTime
  durationMin  Int
  singleAttempt Boolean @default(true)
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  questions   Question[]
  submissions Submission[]

  @@map("exams")
}

/// שאלה אמריקאית. שאלת בונוס אינה נספרת במכנה של הציון.
model Question {
  id       String  @id @default(cuid())
  examId   String
  order    Int
  text     String
  points   Int
  isBonus  Boolean @default(false)

  exam    Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  choices Choice[]
  answers SubmissionAnswer[]

  @@unique([examId, order])
  @@index([examId])
  @@map("questions")
}

/// אפשרות תשובה. בדיוק אחת מסומנת כנכונה לכל שאלה.
model Choice {
  id         String  @id @default(cuid())
  questionId String
  order      Int
  text       String
  isCorrect  Boolean @default(false)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  SubmissionAnswer[]

  @@unique([questionId, order])
  @@index([questionId])
  @@map("choices")
}

/// נבחן — מזוהה לפי תעודת זהות
model Student {
  id         String   @id @default(cuid())
  nationalId String   @unique
  firstName  String
  lastName   String
  email      String?
  createdAt  DateTime @default(now())

  submissions Submission[]

  @@map("students")
}

enum SubmissionStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

/// הגשה. deadlineAt נקבע בשרת ומהווה את מקור האמת לטיימר.
/// הציון מחושב אך ורק בשרת — הלקוח לעולם לא שולח ציון.
model Submission {
  id          String           @id @default(cuid())
  examId      String
  studentId   String
  status      SubmissionStatus @default(IN_PROGRESS)
  startedAt   DateTime         @default(now())
  deadlineAt  DateTime
  submittedAt DateTime?
  score       Int?
  maxScore    Int?
  percentage  Float?
  bonusPoints Int?

  exam    Exam               @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers SubmissionAnswer[]

  @@unique([examId, studentId])
  @@index([examId])
  @@index([studentId])
  @@map("submissions")
}

/// תשובת נבחן לשאלה בודדת
model SubmissionAnswer {
  id           String   @id @default(cuid())
  submissionId String
  questionId   String
  choiceId     String?
  updatedAt    DateTime @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  choice     Choice?    @relation(fields: [choiceId], references: [id], onDelete: SetNull)

  @@unique([submissionId, questionId])
  @@index([submissionId])
  @@map("submission_answers")
}
