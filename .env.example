# ── בסיס נתונים ─────────────────────────────────────────────
# ב-Supabase יש להעתיק את שתי המחרוזות מתוך Connect בלוח הבקרה.
#
# DATABASE_URL  = Transaction pooler (פורט 6543) — לשימוש האפליקציה.
#                 יש להוסיף בסופו pgbouncer=true&connection_limit=1
# DIRECT_URL    = Direct connection (פורט 5432) — למיגרציות בלבד.
#
# בהרצה מול Postgres מקומי אפשר להשתמש באותה מחרוזת בשני המשתנים.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ── אימות ───────────────────────────────────────────────────
# יש לייצר מפתח אמיתי: openssl rand -base64 32
AUTH_SECRET=""

# בפרודקשן — הדומיין המלא של האתר, למשל https://exam.example.com
AUTH_URL="http://localhost:3000"

# ── המרצה הראשוני שנוצר ב-seed ──────────────────────────────
# יש להחליף לפני הרצת db:seed. אלה פרטי ההתחברות לדשבורד.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-please"
SEED_ADMIN_NAME="מרצה הקורס"
